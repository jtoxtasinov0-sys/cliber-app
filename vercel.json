{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/main?__route=:path*" }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=604800" }] }
  ]
}
